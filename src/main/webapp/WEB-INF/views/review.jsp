<%@ page import="java.util.*" %><%@ include file="_header.jspf" %><% Map<String,Object>a=(Map<String,Object>)request.getAttribute("app"); %><h2>Review application #<%=a.get("application_id")%></h2><div class="card mb-3"><div class="card-body"><div class="row"><div class="col-md-6"><p><b>Applicant:</b> <%=a.get("applicant_name")%></p><p><b>Email:</b> <%=a.get("email")%></p><p><b>Product:</b> <%=a.get("product_name")%></p></div><div class="col-md-6"><p><b>Amount:</b> ₹<%=a.get("amount")%></p><p><b>Tenure:</b> <%=a.get("tenure_months")%> months</p><p><b>Estimated EMI:</b> ₹<%=a.get("emi")%></p><p><b>Preliminary score:</b> <%=a.get("eligibility_score")%>/100</p></div></div><p><b>Purpose:</b> <%=a.get("purpose")%></p><p><b>Status:</b> <span class="badge text-bg-info"><%=a.get("status")%></span></p></div></div>
<div class="card mb-3"><div class="card-header">Uploaded documents</div><div class="card-body"><% List<Map<String,Object>> docs=(List<Map<String,Object>>)request.getAttribute("docs");if(docs==null||docs.isEmpty()){ %><p class="text-muted">No documents uploaded.</p><% }else for(Map<String,Object>d:docs){ %><div><%=d.get("document_type")%> — <%=d.get("original_name")%> (stored securely; file-view endpoint can be added for deployment)</div><% } %></div></div>
<div class="card"><div class="card-body"><h5>Record decision</h5><form method="post" action="${pageContext.request.contextPath}/decision"><input type="hidden" name="applicationId" value="<%=a.get("application_id")%>"><label class="form-label">Decision</label><select class="form-select mb-3" name="decision" required><option value="APPROVED">Approve</option><option value="REJECTED">Reject</option><option value="CLARIFICATION_REQUESTED">Request clarification</option></select><label class="form-label">Reason code</label><select class="form-select mb-3" name="reasonCode" required><option value="ELIGIBILITY_MET">Eligibility criteria met</option><option value="INSUFFICIENT_INCOME">Insufficient income</option><option value="DOCUMENTS_INCOMPLETE">Documents incomplete</option><option value="INFORMATION_REQUIRED">Additional information required</option><option value="OTHER">Other</option></select><label class="form-label">Remarks</label><textarea class="form-control mb-3" name="remarks" rows="3"></textarea><button class="btn btn-primary">Save decision</button><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/dashboard">Back</a></form></div></div><%@ include file="_footer.jspf" %>