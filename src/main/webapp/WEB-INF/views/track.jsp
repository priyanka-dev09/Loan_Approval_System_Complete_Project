<%@ page import="java.util.*" %><%@ include file="_header.jspf" %><h2>Application Timeline</h2><p class="text-muted">Application #<%=request.getAttribute("applicationId")%></p><div class="card"><div class="card-body"><% List<Map<String,Object>> items=(List<Map<String,Object>>)request.getAttribute("timeline");if(items==null||items.isEmpty()){ %><p>No timeline events recorded.</p><% }else for(Map<String,Object> item:items){ %><div class="border-start border-3 border-primary ps-3 pb-3 mb-3"><div class="fw-bold"><%=item.get("action")%></div><div><%=item.get("details")==null?"":item.get("details")%></div><small class="text-muted"><%=item.get("created_at")%></small></div><% } %><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/dashboard">Back</a></div></div><%@ include file="_footer.jspf" %>