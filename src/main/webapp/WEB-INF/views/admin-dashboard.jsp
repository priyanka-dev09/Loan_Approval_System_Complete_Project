<%@ page import="java.util.*" %><%@ include file="_header.jspf" %><h2>Administrator Dashboard</h2><p class="text-muted">Manage users, loan products and application overview.</p><div class="row g-3 mb-4"><% List<Map<String,Object>> stats=(List<Map<String,Object>>)request.getAttribute("stats");if(stats!=null)for(Map<String,Object>x:stats){ %><div class="col-sm-6 col-lg-3"><div class="card stat-card"><div class="card-body"><div class="text-muted"><%=x.get("status")%></div><div class="display-6 fw-bold"><%=x.get("total")%></div></div></div></div><% } %></div>
<div class="row g-4"><div class="col-lg-6"><div class="card"><div class="card-header fw-bold">Create Loan Officer</div><div class="card-body"><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="createOfficer"><input class="form-control mb-2" name="name" placeholder="Full name" required><input class="form-control mb-2" name="email" type="email" placeholder="Email" required><input class="form-control mb-2" name="mobile" placeholder="Mobile"><input class="form-control mb-2" name="password" type="password" minlength="8" placeholder="Temporary password" required><button class="btn btn-primary">Create officer</button></form></div></div></div>
<div class="col-lg-6"><div class="card"><div class="card-header fw-bold">Add Loan Product</div><div class="card-body"><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="addProduct"><input class="form-control mb-2" name="name" placeholder="Product name" required><div class="row"><div class="col"><input class="form-control mb-2" name="rate" type="number" step=".01" placeholder="Interest %" required></div><div class="col"><input class="form-control mb-2" name="maxTenure" type="number" placeholder="Max tenure months" required></div></div><div class="row"><div class="col"><input class="form-control mb-2" name="minAmount" type="number" placeholder="Min amount" required></div><div class="col"><input class="form-control mb-2" name="maxAmount" type="number" placeholder="Max amount" required></div></div><button class="btn btn-primary">Add product</button></form></div></div></div></div>
<div class="card mt-4"><div class="card-header fw-bold">Users</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th>Action</th></tr></thead><tbody><% List<Map<String,Object>> users=(List<Map<String,Object>>)request.getAttribute("users");for(Map<String,Object>u:users){ %><tr><td><%=u.get("name")%></td><td><%=u.get("email")%></td><td><%=u.get("role")%></td><td><%=u.get("active")%></td><td><% if(!"ADMIN".equals(u.get("role"))){ %><form method="post" action="${pageContext.request.contextPath}/admin"><input type="hidden" name="action" value="toggleUser"><input type="hidden" name="userId" value="<%=u.get("user_id")%>"><button class="btn btn-sm btn-outline-secondary">Toggle</button></form><% } %></td></tr><% } %></tbody></table></div></div><%@ include file="_footer.jspf" %>