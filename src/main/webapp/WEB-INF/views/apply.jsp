<%@ page import="java.util.*" %><%@ include file="_header.jspf" %><div class="row justify-content-center"><div class="col-lg-8"><div class="card shadow-sm"><div class="card-body p-4"><h2>Loan application</h2><p class="text-muted">Choose a product and enter the requested details.</p>
<% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger"><%=request.getAttribute("error")%></div><% } %>
<form method="post" action="${pageContext.request.contextPath}/loans"><label class="form-label">Loan product</label><select class="form-select mb-3" name="productId" id="product" required><% List<Map<String,Object>> ps=(List<Map<String,Object>>)request.getAttribute("products"); for(Map<String,Object>p:ps){ %><option value="<%=p.get("product_id")%>" data-rate="<%=p.get("interest_rate")%>" data-min="<%=p.get("min_amount")%>" data-max="<%=p.get("max_amount")%>" data-tenure="<%=p.get("max_tenure_months")%>"><%=p.get("name")%> · <%=p.get("interest_rate")%>% p.a. · max ₹<%=p.get("max_amount")%></option><% } %></select>
<div class="row"><div class="col-md-6"><label class="form-label">Loan amount (₹)</label><input class="form-control mb-3" type="number" step="1000" min="1" name="amount" id="amount" required></div><div class="col-md-6"><label class="form-label">Tenure (months)</label><input class="form-control mb-3" type="number" min="1" name="tenure" id="tenure" required></div></div>
<label class="form-label">Purpose</label><textarea class="form-control mb-3" name="purpose" rows="3" required></textarea><div class="alert alert-light border">Estimated EMI: <strong id="emi">₹0.00</strong><div class="small text-muted">Estimate only; actual terms depend on lender review.</div></div><button class="btn btn-primary">Submit application</button> <a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/dashboard">Cancel</a></form></div></div></div></div>
<script>const product=document.getElementById('product'),amount=document.getElementById('amount'),tenure=document.getElementById('tenure'),emi=document.getElementById('emi');function calc(){let o=product.options[product.selectedIndex],P=Number(amount.value),n=Number(tenure.value),r=Number(o.dataset.rate)/1200;let v=(P>0&&n>0&&r>0)?P*r*Math.pow(1+r,n)/(Math.pow(1+r,n)-1):0;emi.textContent='₹'+v.toFixed(2);amount.min=o.dataset.min;amount.max=o.dataset.max;tenure.max=o.dataset.tenure;}[product,amount,tenure].forEach(x=>x.addEventListener('input',calc));calc();</script><%@ include file="_footer.jspf" %>