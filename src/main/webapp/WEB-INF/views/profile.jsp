<%@ include file="_header.jspf" %><%@ page import="java.util.*" %><% Map<String,Object> p=(Map<String,Object>)request.getAttribute("profile"); %><div class="row justify-content-center"><div class="col-lg-8"><div class="card"><div class="card-body p-4"><h2>Manage Profile</h2><% if("1".equals(request.getParameter("saved"))){ %><div class="alert alert-success">Profile updated.</div><% } %><form method="post" action="${pageContext.request.contextPath}/profile"><label class="form-label">Full name</label><input class="form-control mb-3" name="name" value="<%=p.get("name")%>" required><label class="form-label">Email (read-only)</label><input class="form-control mb-3" value="<%=p.get("email")%>" readonly><label class="form-label">Mobile</label><input class="form-control mb-3" name="mobile" value="<%=p.get("mobile")==null?"":p.get("mobile")%>"><label class="form-label">Date of birth</label><input class="form-control mb-3" type="date" name="dob" value="<%=p.get("dob")==null?"":p.get("dob")%>"><label class="form-label">Address</label><textarea class="form-control mb-3" name="address"><%=p.get("address")==null?"":p.get("address")%></textarea><label class="form-label">Employment type</label><select class="form-select mb-3" name="employmentType"><option>Not specified</option><option>Employed</option><option>Self-employed</option><option>Student</option><option>Other</option></select><label class="form-label">Monthly income (₹)</label><input class="form-control mb-3" type="number" min="0" step=".01" name="monthlyIncome" value="<%=p.get("monthly_income")==null?"0":p.get("monthly_income")%>" required><label class="form-label">Existing monthly EMI (₹)</label><input class="form-control mb-3" type="number" min="0" step=".01" name="existingEmi" value="<%=p.get("existing_emi")==null?"0":p.get("existing_emi")%>" required><button class="btn btn-primary">Save profile</button><a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/dashboard">Back</a></form></div></div></div></div><%@ include file="_footer.jspf" %>