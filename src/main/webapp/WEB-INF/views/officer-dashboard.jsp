<%@ page import="java.util.*" %><%@ include file="_header.jspf" %><h2>Loan Officer Dashboard</h2><p class="text-muted">Review submitted applications and record decisions.</p><div class="card"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>ID</th><th>Applicant</th><th>Product</th><th>Amount</th><th>EMI</th><th>Status</th><th></th></tr></thead><tbody><% List<Map<String,Object>> apps=(List<Map<String,Object>>)request.getAttribute("applications");if(apps==null||apps.isEmpty()){ %><tr><td colspan="7" class="text-center p-4">No applications awaiting review.</td></tr><% }else for(Map<String,Object>a:apps){ %><tr><td>#<%=a.get("application_id")%></td><td><%=a.get("applicant_name")%></td><td><%=a.get("product_name")%></td><td>₹<%=a.get("amount")%></td><td>₹<%=a.get("emi")%></td><td><%=a.get("status")%></td><td><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/review?id=<%=a.get("application_id")%>">Review</a></td></tr><% } %></tbody></table></div></div><%@ include file="_footer.jspf" %>