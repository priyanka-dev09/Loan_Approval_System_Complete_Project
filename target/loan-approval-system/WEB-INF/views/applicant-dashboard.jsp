<%@ page import="java.util.*" %><%@ include file="_header.jspf" %><div class="d-flex justify-content-between align-items-center mb-3"><div><h2>Applicant Dashboard</h2><p class="text-muted">Apply for a loan and track your applications.</p></div><div><a class="btn btn-outline-primary me-2" href="${pageContext.request.contextPath}/profile">Manage Profile</a><a class="btn btn-primary" href="${pageContext.request.contextPath}/loans">+ Apply for Loan</a></div></div>
<% if("1".equals(request.getParameter("submitted"))){ %><div class="alert alert-success">Your application has been submitted.</div><% } %>
<div class="card"><div class="card-header fw-semibold">My applications</div><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>ID</th><th>Product</th><th>Amount</th><th>Tenure</th><th>EMI</th><th>Eligibility</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<% List<Map<String,Object>> apps=(List<Map<String,Object>>)request.getAttribute("applications"); if(apps==null||apps.isEmpty()){ %><tr><td colspan="8" class="text-center text-muted p-4">No applications yet.</td></tr><% } else for(Map<String,Object>a:apps){ %><tr><td>#<%=a.get("application_id")%></td><td><%=a.get("product_name")%></td><td>₹<%=a.get("amount")%></td><td><%=a.get("tenure_months")%> months</td><td>₹<%=a.get("emi")%></td><td><%=a.get("eligibility_score")%>/100*</td><td><span class="badge text-bg-info"><%=a.get("status")%></span></td><td><a class="btn btn-sm btn-outline-primary mb-1" href="${pageContext.request.contextPath}/track?id=<%=a.get("application_id")%>">Track</a><form class="d-inline-flex gap-1" method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/documents/upload"><input type="hidden" name="applicationId" value="<%=a.get("application_id")%>"><input type="hidden" name="documentType" value="Supporting Document"><input class="form-control form-control-sm" style="max-width:150px" type="file" name="file" accept=".pdf,.jpg,.jpeg,.png" required><button class="btn btn-sm btn-outline-secondary">Upload</button></form></td></tr><% } %>
</tbody></table></div></div><p class="small text-muted mt-2">*Preliminary rule-based indicator only; final decision is made by an authorised loan officer.</p><%@ include file="_footer.jspf" %>