<%@ include file="_header.jspf" %><div class="row justify-content-center"><div class="col-md-6"><div class="card shadow-sm"><div class="card-body p-4"><h3>Applicant registration</h3>
<% if(request.getAttribute("error")!=null){ %><div class="alert alert-danger"><%=request.getAttribute("error")%></div><% } %>
<form method="post" action="${pageContext.request.contextPath}/register"><label class="form-label">Full name</label><input class="form-control mb-3" name="name" required><label class="form-label">Email</label><input class="form-control mb-3" name="email" type="email" required><label class="form-label">Mobile</label><input class="form-control mb-3" name="mobile"><label class="form-label">Password (minimum 8 characters)</label><input class="form-control mb-3" name="password" type="password" minlength="8" required><button class="btn btn-primary w-100">Register</button></form><p class="mt-3">Already registered? <a href="${pageContext.request.contextPath}/login">Login</a></p></div></div></div></div><%@ include file="_footer.jspf" %>